<?xml version="1.0" encoding="utf-8"?>
<!-- The journey database is encrypted with a key held in the Android
     Keystore, which is never backed up or transferred. Copying the database
     without its key would restore unreadable data, so nothing is included in
     cloud backup or device-to-device transfer. Backup is an explicit,
     opt-in app feature instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
